# Micro Sniper 环境配置

# 应用
APP__PORT=1111
APP__DEBUG=true

# 数据库
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__USER=postgres
DATABASE__PASSWORD=your_password
DATABASE__DATABASE=micro_sniper

# AgentBay
AGENTBAY__API_KEY=your_agentbay_api_key

# API Key（用于前端认证，运行 scripts/generate_api_key.py 生成）
SECURITY__API_KEY=sk-your-generated-key-here

# Redis
REDIS__HOST=localhost
REDIS__PORT=6379

# OSS（截图上传）
OSS__ACCESS_KEY_ID=
OSS__ACCESS_KEY_SECRET=
OSS__BUCKET_NAME=
